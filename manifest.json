{
  "manifest_version": 3,
  "name": "Media Resource Finder",
  "version": "0.2.0",
  "description": "Detect media requests and send direct MP4 downloads to the local downloader.",
  "permissions": ["activeTab", "storage", "webRequest"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "媒体资源嗅探器",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
